# Copy this file to .env and adjust before running `docker compose up -d --build`.
# docker-compose.yml reads these automatically from a .env file in this directory.

# PostgreSQL credentials used by the db and backend services.
POSTGRES_DB=wikiself
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Base64-encoded symmetric key used to sign JWT access tokens. Generate a fresh one for
# any real deployment, e.g.: openssl rand -base64 64
JWT_SECRET=change-me-to-a-random-base64-secret

# Origin the app is served from (host/IP + the published nginx port). Only used for the
# backend's CORS allow-list; same-origin requests through nginx don't need it, but it's
# useful if you ever call the API directly instead of through the proxy.
PUBLIC_ORIGIN=http://localhost:8082
